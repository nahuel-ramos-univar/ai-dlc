{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/observe.py --permission-allow",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "python3 .cursor/hooks/observe.py",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/observe.py",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 .cursor/hooks/observe.py",
        "timeout": 5
      }
    ],
    "afterMCPExecution": [
      {
        "command": "python3 .cursor/hooks/observe.py",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "python3 .cursor/hooks/observe.py",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/observe.py",
        "timeout": 5
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 .cursor/hooks/observe.py",
        "timeout": 5
      }
    ]
  }
}
